{
  "name": "roosta",
  "version": "0.1.0",
  "description": "Roosta - Rotating Savings (ROSCA) on Solana",
  "license": "MIT",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "qa:typecheck": "cd app && npx tsc --noEmit && cd .. && npx tsc -p tsconfig.json --noEmit",
    "qa:lint": "cd app && npx eslint --max-warnings=0 . && cd .. && pnpm run lint || npm run lint",
    "qa:unit": "anchor test --skip-build --provider.cluster localnet",
    "qa:integration": "anchor test --skip-build --provider.cluster localnet",
    "qa:build": "cd app && npx next build",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "qa:build:cold": "node scripts/qa-build-cold.mjs",
    "qa:e2e": "playwright test --config=playwright.config.ts",
    "qa:e2e:prod": "PLAYWRIGHT_USE_PROD=1 playwright test --config=playwright.config.ts",
    "qa:all": "npm run qa:typecheck && npm run qa:lint && npm run qa:build && npm run qa:integration && npm run qa:e2e:prod"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.3.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
